MANIFEST

# Virtual environments.
# Anchored to the repository root: unanchored "env/" also matched
# webreplay-standalone/src/env/, which silently kept real source out of the
# repo (git is case-insensitive here, so "ENV/" matched "env/" too).
/.env
/.venv
/env/
/venv/
/ENV/
/env.bak/
/venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints

# Testing
.pytest_cache/
.coverage
htmlcov/

# Node modules (for webreplay-standalone)
node_modules/
npm-debug.log*

# Legacy top-level copies of packages that now live under src/orby/.
# Kept as ignore rules so stale checkouts do not get re-committed.
digital-agent/
/prompt_template_manager/
/protos/

# Build artifacts
*.whl
*.tar.gz

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs
*.log

# Large data files
*.zip
*.parquet
.cache/
**/web_archives/*.zip
**/.cache/*.parquet
